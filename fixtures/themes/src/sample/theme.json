      "asset": "cards",
      "fit": "cover",
      "opacity": 0.4
    },
    "buttons.primary.background": {
      "asset": "buttons",
      "fit": "cover"
    },
    "emptyState.illustration": {
      "asset": "empty-state",
      "fit": "contain"
