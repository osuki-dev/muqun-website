# Local development only. Copy to `.env`; `.env` is gitignored.
#
# The first two are read by `scripts/themes-dev-source.mjs` while `astro dev`
# runs, and by nothing else. Neither reaches a build or the browser: the
# production page always reads this site's own /api/themes/, and dev with no
# `.env` reads the production API at https://muqun.dev/api/themes/.

# Serve the themes gallery from a directory instead of GitHub. The one in
# this repository holds an `index.json` and one packed theme, so the page
# renders with no network at all.
MUQUN_THEMES_FIXTURE=fixtures/themes

# Or proxy to the private `osuki-dev/muqun-themes` repository with a token
# that can read it (a fine-grained token with Contents: read is enough).
# Ignored while MUQUN_THEMES_FIXTURE is set. Never commit a real value.
# MUQUN_THEMES_TOKEN=

# Which repository and ref the gallery reads (`src/lib/themes-repo.ts`).
# `PUBLIC_` because both reach the client bundle as URLs. Defaults shown;
# the release ref carries the built `index.json` and `dist/` packages.
# PUBLIC_MUQUN_THEMES_REPO=osuki-dev/muqun-themes
# PUBLIC_MUQUN_THEMES_REF=release

# Store buttons' limited-time promo tips (shown on hover/focus).
# Opt-in: unset or anything but 1/true/yes/on renders plain store buttons
# with no promo markup. Set for the duration of the promo, unset after.
# PUBLIC_MUQUN_STORE_PROMO=1
