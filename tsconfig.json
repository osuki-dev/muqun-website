{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "src/**/*.test.ts", "src/**/*.test.tsx", "src/**/__tests__/**"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "types": ["@cloudflare/workers-types"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] }
  }
}
