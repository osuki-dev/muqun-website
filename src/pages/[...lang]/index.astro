---
import FilmPanel from "@/components/FilmPanel.astro";
import { introVideoSrc, introVideoPoster, introVideoPortraitSrc, introVideoPortraitPoster } from "@/lib/muqun-assets";
import Layout from "@/layouts/Layout.astro";
import PocketWorld from "@/components/world/PocketWorld";
import FeatureGallery from "@/components/FeatureGallery.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import { getMuqunCopy } from "@/i18n/muqun";
import { gatewayHelp, gatewayCommands } from "@/i18n/gateway-help";
import { opencodeHome } from "@/i18n/opencode-home";
import { worldCopy } from "@/i18n/world";
import { getFeatures } from "@/lib/features";
import { localizedPath, siteLocaleCodes, defaultLocale } from "@/lib/locales";
import {
  appStoreUrl,
  playStoreUrl,
  gatewayInstallCommand,
  gatewayRepoUrl,
} from "@/lib/muqun-links";
import { appStoreAvailable } from "@/lib/muqun-release";
import { storePromoActive } from "@/lib/muqun-promo";
import "@/styles/world.css";
export function getStaticPaths() {
  return siteLocaleCodes.map((locale) => ({
    params: { lang: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}
const { locale } = Astro.props;
const copy = getMuqunCopy(locale),
  world = worldCopy[locale];
const features = getFeatures(locale);
const help = gatewayHelp[locale];
const opencode = opencodeHome[locale];

/**
 * The agent chapter's link, which is an anchor on another page.
 *
 * Built from `localizedPath` rather than written out, so it carries the
 * reader's language and the trailing slash the rest of the site links with --
 * `/ja/support/#opencode`, not `/support#opencode`.
 */
const opencodeGuideHref = `${localizedPath("/support", locale)}#opencode`;
---

<Layout lang={locale} title={copy.meta.title} description={world.intro}>
  <div id="world-story" class="world-story">
    <div class="world-stage">
      <PocketWorld client:load />
    </div>
    <div class="world-content">
      <section class="world-hero story-chapter" id="pocket">
        <div class="hero-copy">
          <p class="world-eyebrow">
            <span class="signal-dot"></span> {world.eyebrow}
          </p>
          <h1>
            <span class="hero-title-lead">{world.title}</span>{" "}
            <span class="hero-title-accent">{world.accent}</span>
          </h1>
          <p class="world-intro">{world.intro}</p>
          <div class="world-actions">
            {appStoreAvailable ? (
              <a class="world-button primary" href={appStoreUrl} data-tip={storePromoActive ? world.appStoreTip : undefined}>
                <span aria-hidden="true">↗</span> App Store
              </a>
            ) : (
              <p>{copy.review.status}</p>
            )}
            <a class="world-button secondary" href={playStoreUrl} data-tip={storePromoActive ? world.playStoreTip : undefined}>
              Google Play <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <a class="hero-coordinate hero-scroll" href="#terminal">
          {world.explore} <span aria-hidden="true">↓</span>
        </a>
        <div class="hero-wordmark" aria-hidden="true">
          muqun<span>®</span>
        </div>
      </section>
      <section id="film" class="home-film" aria-label="Muqun 3.0">
        <p class="world-eyebrow">MUQUN / 3.0</p>
        <FilmPanel src={introVideoSrc} poster={introVideoPoster} portraitSrc={introVideoPortraitSrc} portraitPoster={introVideoPortraitPoster} alt="Muqun 3.0" playLabel={copy.hero.videoPlayLabel} length="0:20" />
      </section>
      <section class="story-chapter terminal-chapter" id="terminal">
        <div class="chapter-copy" data-world-reveal>
          <p class="world-eyebrow">01 / {copy.pillars.paneLabel}</p>
          <h2>{world.features}</h2>
          <p>{world.featureIntro}</p>
          <div class="session-preview">
            <div class="session-top">
              <span class="signal-dot"></span> muqun{" "}
              <span>claude · codex · nvim</span>
            </div>
            <div class="session-lines">
              <span class="code-muted">~/your-next-big-idea</span>
              <br />
              <span class="code-mint">❯</span> <span>claude</span>
              <br />
              <br />
              <span class="code-coral">●</span>{" "}
              {features.find((feature) => feature.id === "approve")?.title}
              <br />
              <span class="code-muted">src / something-wonderful.ts</span>
            </div>
            <div class="session-caption">
              {world.simulated}
              <span aria-hidden="true">↗</span>
            </div>
          </div>
        </div>
      </section>
      <section class="features-section" aria-label={world.features}>
        <FeatureGallery
          features={[
            ...features.filter((f) => f.spotlight),
            ...features.filter((f) => !f.spotlight),
          ]}
        />
      </section>
      {/* The agent chapter. After the gallery because it is the one feature
          with a screen of its own rather than a line in a grid, and before
          setup because setup is what you do once you want it. */}
      <section class="story-chapter" id="opencode">
        <div class="chapter-copy" data-world-reveal>
          <p class="world-eyebrow">02 / {opencode.eyebrow}</p>
          <h2>{opencode.heading}</h2>
          <p>{opencode.body}</p>
          <ul class="world-requirements">
            {opencode.facts.map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
          <a class="text-link" href={opencodeGuideHref}>
            {opencode.link} ↗
          </a>
        </div>
      </section>
      <section class="story-chapter connect-chapter" id="connect">
        <div class="chapter-copy" data-world-reveal>
          <p class="world-eyebrow">03 / {copy.setup.paneLabel}</p>
          <h2>{copy.setup.heading}</h2>
          <div class="world-command">
            <CodeBlock
              copy
              wrap
              code={gatewayInstallCommand}
              label={copy.hero.installLabel}
              copyLabel={world.copyLabel}
              copiedLabel={copy.hero.copiedLabel}
            />
          </div>
          <ol class="world-steps">
            {help.steps.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{step}</h3>
                  {index === 0 && <CodeBlock copy wrap code="muqun-gateway manage" copyLabel={world.copyLabel} copiedLabel={copy.hero.copiedLabel} /> }
                </div>
              </li>
            ))}
          </ol>
          <p class="pairing-note">{help.manual}</p>
          <details class="gateway-help">
            <summary>{help.heading}<span aria-hidden="true">+</span></summary>
            <div class="gateway-help-content">
              <p>{help.keys}</p>
              <p>{help.serviceNote}</p>
              {help.modes.map((mode, modeIndex) => (
                <section class="gateway-mode">
                  <h3>{mode}</h3>
                  {gatewayCommands.slice(modeIndex * 3, modeIndex * 3 + 3).map((command, index) => (
                    <CodeBlock copy wrap code={`muqun-gateway ${command}`} label={help.labels[modeIndex * 3 + index]} copyLabel={world.copyLabel} copiedLabel={copy.hero.copiedLabel} />
                  ))}
                </section>
              ))}
              <CodeBlock copy wrap code="muqun-gateway --help" label={help.labels[6]} copyLabel={world.copyLabel} copiedLabel={copy.hero.copiedLabel} />
            </div>
          </details>
          <ul class="world-requirements">
            {copy.setup.requirements.slice(0, 2).map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a class="text-link" href={gatewayRepoUrl}>
            {copy.setup.openSourceLink} ↗
          </a>
        </div>
      </section>
      <section class="privacy-strip" data-world-reveal>
        <div>
          <p class="world-eyebrow">04 / {copy.promise.paneLabel}</p>
          <h2>{world.privacy}</h2>
        </div>
        <div>
          <ul>
            {copy.promise.lines.slice(1, 4).map((line) => (
              <li>
                <span aria-hidden="true">↗</span>
                {line}
              </li>
            ))}
          </ul>
          <a class="text-link" href={localizedPath("/privacy", locale)}>
            {copy.promise.link} ↗
          </a>
        </div>
      </section>
      <section class="story-chapter download-chapter" id="anywhere">
        <div class="chapter-copy" data-world-reveal>
          <p class="world-eyebrow">05 / MUQUN</p>
          <h2>{world.end}</h2>
          <div class="world-actions">
            {appStoreAvailable && (
              <a class="world-button primary" href={appStoreUrl} data-tip={storePromoActive ? world.appStoreTip : undefined}>
                {copy.footer.appStore} ↗
              </a>
            )}
            <a class="world-button secondary" href={playStoreUrl} data-tip={storePromoActive ? world.playStoreTip : undefined}>
              {copy.footer.googlePlay} ↗
            </a>
          </div>

          <a class="text-link" href={localizedPath("/support", locale)}>
            {copy.footer.support} ↗
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .home-film {
    width: min(1440px, 100%);
    margin: auto;
    padding: 48px 6vw 80px;
    pointer-events: auto;
    scroll-margin-top: 6rem;
  }
  .home-film :global(.mq-film) { margin-inline: auto; }
</style>
