---
import Layout from "@/layouts/Layout.astro";
import PocketWorld from "@/components/world/PocketWorld";
import FeatureGallery from "@/components/FeatureGallery.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import { getMuqunCopy } from "@/i18n/muqun";
import { worldCopy } from "@/i18n/world";
import { getFeatures } from "@/lib/features";
import { localizedPath, siteLocaleCodes, defaultLocale } from "@/lib/locales";
import {
  appStoreUrl,
  playStoreUrl,
  gatewayInstallCommand,
  gatewayRepoUrl,
} from "@/lib/muqun-links";
import { appStoreAvailable } from "@/lib/muqun-release";
import "@/styles/world.css";
export function getStaticPaths() {
  return siteLocaleCodes.map((locale) => ({
    params: { lang: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}
const { locale } = Astro.props;
const copy = getMuqunCopy(locale),
  world = worldCopy[locale];
const features = getFeatures(locale);
---

<Layout lang={locale} title={copy.meta.title} description={world.intro}>
  <div id="world-story" class="world-story">
    <div class="world-stage">
      <PocketWorld client:load />
    </div>
    <div class="world-content">
      <section class="world-hero story-chapter" id="pocket">
        <div class="hero-copy">
          <p class="world-eyebrow">
            <span class="signal-dot"></span> {world.eyebrow}
          </p>
          <h1>
            <span class="hero-title-lead">{world.title}</span>{" "}
            <span class="hero-title-accent">{world.accent}</span>
          </h1>
          <p class="world-intro">{world.intro}</p>
          <div class="world-actions">
            {appStoreAvailable ? (
              <a class="world-button primary" href={appStoreUrl}>
                <span aria-hidden="true">↗</span> App Store
              </a>
            ) : (
              <p>{copy.review.status}</p>
            )}
            <a class="world-button secondary" href={playStoreUrl}>
              Google Play <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <a class="hero-coordinate hero-scroll" href="#terminal">
          {world.explore} <span aria-hidden="true">↓</span>
        </a>
        <div class="hero-wordmark" aria-hidden="true">
          muqun<span>®</span>
        </div>
      </section>
      <section class="story-chapter terminal-chapter" id="terminal">
        <div class="chapter-copy" data-world-reveal>
          <p class="world-eyebrow">01 / {copy.pillars.paneLabel}</p>
          <h2>{world.features}</h2>
          <p>{world.featureIntro}</p>
          <div class="session-preview">
            <div class="session-top">
              <span class="signal-dot"></span> muqun{" "}
              <span>claude · codex · nvim</span>
            </div>
            <div class="session-lines">
              <span class="code-muted">~/your-next-big-idea</span>
              <br />
              <span class="code-mint">❯</span> <span>claude</span>
              <br />
              <br />
              <span class="code-coral">●</span>{" "}
              {features.find((feature) => feature.id === "approve")?.title}
              <br />
              <span class="code-muted">src / something-wonderful.ts</span>
            </div>
            <div class="session-caption">
              {world.simulated}
              <span aria-hidden="true">↗</span>
            </div>
          </div>
        </div>
      </section>
      <section class="features-section" aria-label={world.features}>
        <FeatureGallery
          features={[
            ...features.filter((f) => f.spotlight),
            ...features.filter((f) => !f.spotlight),
          ]}
          sourceLabel={world.source}
          developmentLabel={world.development}
        />
      </section>
      <section class="story-chapter connect-chapter" id="connect">
        <div class="chapter-copy" data-world-reveal>
          <p class="world-eyebrow">02 / {copy.setup.paneLabel}</p>
          <h2>{copy.setup.heading}</h2>
          <div class="world-command">
            <CodeBlock
              copy
              wrap
              code={gatewayInstallCommand}
              label={copy.hero.installLabel}
              copyLabel={world.copyLabel}
              copiedLabel={copy.hero.copiedLabel}
            />
          </div>
          <ol class="world-steps">
            {copy.setup.steps.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{step.title}</h3>
                </div>
              </li>
            ))}
          </ol>
          <ul class="world-requirements">
            {copy.setup.requirements.slice(0, 2).map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a class="text-link" href={gatewayRepoUrl}>
            {copy.setup.openSourceLink} ↗
          </a>
        </div>
      </section>
      <section class="privacy-strip" data-world-reveal>
        <div>
          <p class="world-eyebrow">03 / {copy.promise.paneLabel}</p>
          <h2>{world.privacy}</h2>
        </div>
        <div>
          <ul>
            {copy.promise.lines.slice(1, 4).map((line) => (
              <li>
                <span aria-hidden="true">↗</span>
                {line}
              </li>
            ))}
          </ul>
          <a class="text-link" href={localizedPath("/privacy", locale)}>
            {copy.promise.link} ↗
          </a>
        </div>
      </section>
      <section class="story-chapter download-chapter" id="anywhere">
        <div class="chapter-copy" data-world-reveal>
          <p class="world-eyebrow">04 / MUQUN</p>
          <h2>{world.end}</h2>
          <div class="world-actions">
            {appStoreAvailable && (
              <a class="world-button primary" href={appStoreUrl}>
                {copy.footer.appStore} ↗
              </a>
            )}
            <a class="world-button secondary" href={playStoreUrl}>
              {copy.footer.googlePlay} ↗
            </a>
          </div>

          <a class="text-link" href={localizedPath("/support", locale)}>
            {copy.footer.support} ↗
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>
