---
import FilmPanel from "@/components/FilmPanel.astro";
import { introVideoSrc, introVideoPoster, introVideoPortraitSrc, introVideoPortraitPoster } from "@/lib/muqun-assets";
import Layout from "@/layouts/Layout.astro";
import PocketWorld from "@/components/world/PocketWorld";
import FeatureGallery from "@/components/FeatureGallery.astro";
import CodeBlock from "@/components/CodeBlock.astro";
import { getMuqunCopy } from "@/i18n/muqun";
import { gatewayHelp } from "@/i18n/gateway-help";
import { agentsHome } from "@/i18n/agents-home";
import { worldCopy } from "@/i18n/world";
import { releaseHome } from "@/i18n/release-home";
import { getFeatures } from "@/lib/features";
import { localizedPath, siteLocaleCodes, defaultLocale } from "@/lib/locales";
import {
  appStoreUrl,
  playStoreUrl,
  gatewayInstallCommand,
  gatewayRepoUrl,
} from "@/lib/muqun-links";
import { appStoreAvailable } from "@/lib/muqun-release";
import { storePromoActive } from "@/lib/muqun-promo";
import "@/styles/world.css";
export function getStaticPaths() {
  return siteLocaleCodes.map((locale) => ({
    params: { lang: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}
const { locale } = Astro.props;
const copy = getMuqunCopy(locale),
  world = worldCopy[locale];
const features = getFeatures(locale);
const help = gatewayHelp[locale];
const release = releaseHome[locale];
const agents = { ...agentsHome[locale], facts: [...agentsHome[locale].facts.slice(1, 4), release.credentials] };
const fresh = features.filter((feature) => feature.group === "new");
const everyday = features.filter((feature) => feature.group === "everyday");

/**
 * The agents chapter's link, which is an anchor on another page.
 *
 * Built from `localizedPath` rather than written out, so it carries the
 * reader's language and the trailing slash the rest of the site links with --
 * `/ja/support/#agents`, not `/support#agents`.
 */
const agentsGuideHref = `${localizedPath("/support", locale)}#agents`;
---

<Layout lang={locale} title={copy.meta.title} description={world.intro} version="4.0.0">
  <div id="world-story" class="world-story">
    <div class="world-stage">
      <PocketWorld client:load />
    </div>
    <div class="world-content">
      <section class="world-hero story-chapter" id="pocket">
        <div class="hero-copy">
          <p class="world-eyebrow">
            <span class="signal-dot"></span> MUQUN / 4.0.0
          </p>
          <h1>
            <span class="hero-title-lead">{world.title}</span>{" "}
            <span class="hero-title-accent">{world.accent}</span>
          </h1>
          <p class="world-intro">{world.intro}</p>
          <div class="world-actions">
            {appStoreAvailable ? (
              <a class="world-button primary" href={appStoreUrl} data-tip={storePromoActive ? world.appStoreTip : undefined}>
                <span aria-hidden="true">↗</span> App Store
              </a>
            ) : (
              <p>{copy.review.status}</p>
            )}
            <a class="world-button secondary" href={playStoreUrl} data-tip={storePromoActive ? world.playStoreTip : undefined}>
              Google Play <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="hero-agents-strip">
            <span class="hero-agents-label"><span class="signal-dot mini"></span>{world.native}</span>
            <span class="hero-agent-pill hero-agent-pill--highlight">✦ Codex</span>
            <span class="hero-agent-pill hero-agent-pill--highlight">✦ OpenCode</span>
            <span class="hero-agent-pill">DeepSeek Harness</span>
            <span class="hero-agent-pill">T3 Code</span>
          </div>
        </div>
        <a class="hero-coordinate hero-scroll" href="#connect">
          {world.explore} <span aria-hidden="true">↓</span>
        </a>
        <div class="hero-wordmark" aria-hidden="true">
          muqun<span>®</span>
        </div>
      </section>
      {/* The intro film, cut for 3.0 and not yet re-shot for 4.0: labelled as
          the film, not as a version, so the page does not carry two numbers. */}
      <section id="film" class="home-film" aria-label={copy.footer.heading}>
        <p class="world-eyebrow">MUQUN / FILM · 0:20</p>
        <FilmPanel src={introVideoSrc} poster={introVideoPoster} portraitSrc={introVideoPortraitSrc} portraitPoster={introVideoPortraitPoster} alt={copy.footer.heading} playLabel={copy.hero.videoPlayLabel} length="0:20" />
      </section>
      {/* How it works, straight after the film: the half of the setup a
          visitor does not expect is the one command on their own computer,
          so it is the first thing after the pitch rather than the sixth. */}
      <section class="story-chapter connect-chapter" id="connect">
        <div class="chapter-copy" data-world-reveal>
          <p class="world-eyebrow">01 / {copy.setup.paneLabel}</p>
          <h2>{world.howTitle}</h2>
          <ol class="world-steps">
            <li>
              <span>01</span>
              <div>
                <h3>{world.how1Title}</h3>
                <p>{world.how1Body}</p>
                <p class="world-step-links">
                  {appStoreAvailable && <a class="text-link" href={appStoreUrl}>App Store ↗</a>}
                  <a class="text-link" href={playStoreUrl}>Google Play ↗</a>
                </p>
              </div>
            </li>
            <li>
              <span>02</span>
              <div>
                <h3>{world.how2Title}</h3>
                <p>{world.how2Body}</p>
                <CodeBlock copy wrap code={gatewayInstallCommand} label={copy.hero.installLabel} copyLabel={world.copyLabel} copiedLabel={copy.hero.copiedLabel} />
              </div>
            </li>
            <li>
              <span>03</span>
              <div>
                <h3>{world.how3Title}</h3>
                <p>{world.how3Body}</p>
                <CodeBlock copy wrap code="muqun-gateway manage" copyLabel={world.copyLabel} copiedLabel={copy.hero.copiedLabel} />
              </div>
            </li>
          </ol>
          <p class="pairing-note">{help.manual}</p>
          <p class="world-step-links">
            <a class="text-link" href={`${localizedPath("/support", locale)}#get-started`}>{world.guideLink} ↗</a>
            <a class="text-link" href={gatewayRepoUrl}>{copy.setup.openSourceLink} ↗</a>
          </p>
        </div>
      </section>
      <section class="features-section" id="features" aria-labelledby="features-new">
        <div class="feature-group-heading" data-world-reveal>
          <span class="feature-number">02</span>
          <h2 id="features-new">{world.whatsNew}</h2>
        </div>
        <FeatureGallery features={fresh} />
        <div class="feature-release-note feature-release-note--after" data-world-reveal>
          <p>{release.compatibility}</p>
        </div>
      </section>
      {/* The agents chapter. After the gallery because agents are the one
          feature with a screen of their own rather than a line in a grid, and
          before setup because setup is what you do once you want it. */}
      <section class="story-chapter" id="agents">
        <div class="chapter-copy" data-world-reveal>
          <p class="world-eyebrow">03 / {agents.eyebrow}</p>
          <h2>{agents.heading}</h2>
          <p>{agents.body}</p>
          {agents.cards && (
            <div class="agent-cards-grid">
              {agents.cards.map((card) => (
                <div class={`agent-highlight-card ${card.id === 'codex' || card.id === 'opencode' ? 'agent-highlight-card--featured' : ''}`}>
                  <div class="agent-highlight-card__header">
                    <span class="agent-name">{card.name}</span>
                    <span class={`agent-tag ${card.id === 'codex' || card.id === 'opencode' ? 'agent-tag--primary' : ''}`}>{card.tag}</span>
                  </div>
                  <p class="agent-desc">{card.desc}</p>
                </div>
              ))}
            </div>
          )}
          <ul class="world-requirements">
            {agents.facts.map((fact) => (
              <li>{fact}</li>
            ))}
          </ul>
          <a class="text-link" href={agentsGuideHref}>
            {agents.link} ↗
          </a>
        </div>
      </section>
      {/* The everyday workspace, as a list rather than a wall of tiles: ten
          things the app does every day, one line each. */}
      <section class="features-section everyday-section" id="everyday" aria-labelledby="everyday-heading">
        <div class="feature-group-heading" data-world-reveal>
          <span class="feature-number">04</span>
          <h2 id="everyday-heading">{release.tools}</h2>
        </div>
        <ul class="everyday-list">
          {everyday.map((feature) => (
            <li>
              <span class="feature-symbol" aria-hidden="true">{feature.icon}</span>
              <div>
                <h3>{feature.title}</h3>
                <p>{feature.description}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
      <section class="privacy-strip" data-world-reveal>
        <div>
          <p class="world-eyebrow">04 / {copy.promise.paneLabel}</p>
          <h2>{world.privacy}</h2>
        </div>
        <div>
          <ul>
            {copy.promise.lines.slice(1, 4).map((line) => (
              <li>
                <span aria-hidden="true">↗</span>
                {line}
              </li>
            ))}
          </ul>
          <a class="text-link" href={localizedPath("/privacy", locale)}>
            {copy.promise.link} ↗
          </a>
        </div>
      </section>
      <section class="story-chapter download-chapter" id="anywhere">
        <div class="chapter-copy" data-world-reveal>
          <p class="world-eyebrow">05 / MUQUN</p>
          <h2>{world.end}</h2>
          <div class="world-actions">
            {appStoreAvailable && (
              <a class="world-button primary" href={appStoreUrl} data-tip={storePromoActive ? world.appStoreTip : undefined}>
                {copy.footer.appStore} ↗
              </a>
            )}
            <a class="world-button secondary" href={playStoreUrl} data-tip={storePromoActive ? world.playStoreTip : undefined}>
              {copy.footer.googlePlay} ↗
            </a>
          </div>

          <a class="text-link" href={localizedPath("/support", locale)}>
            {copy.footer.support} ↗
          </a>
        </div>
      </section>
    </div>
  </div>
</Layout>

<style>
  .home-film {
    width: min(1440px, 100%);
    margin: auto;
    padding: 48px 6vw 80px;
    pointer-events: auto;
    scroll-margin-top: 6rem;
  }
  .home-film :global(.mq-film) { margin-inline: auto; }
</style>
