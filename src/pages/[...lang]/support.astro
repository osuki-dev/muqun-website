---
/**
 * The user guide & support manual — every locale, one file.
 *
 * ── What this page is ───────────────────────────────────────────────────────
 * A complete developer guide and reference manual for Muqun, the Gateway,
 * and the OpenCode agent.
 *
 * Anchor IDs (#get-started, #terminal, #opencode, #gateway, #themes,
 * #troubleshooting, #contact) are deep-linked from inside shipped mobile
 * binaries and must remain immutable.
 *
 * ── Design Language & Register ──────────────────────────────────────────────
 * - Tmux pane bars with indices and meta tags on every major chapter.
 * - Docked status line navigation with real-time active section tracking.
 * - Interactive Chapter Deck in the hero for immediate wayfinding.
 * - High-density parameter matrices, comparison decks, and diagnostic cards.
 */
import Layout from '@/layouts/Layout.astro';
import Band from '@/components/Band.astro';
import Button from '@/components/Button.astro';
import CodeBlock from '@/components/CodeBlock.astro';
import DeviceShot from '@/components/DeviceShot.astro';
import Display from '@/components/Display.astro';
import FactList from '@/components/FactList.astro';
import Grid from '@/components/Grid.astro';
import Prose from '@/components/Prose.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import Step from '@/components/Step.astro';
import Steps from '@/components/Steps.astro';
import type { StatusLineItem } from '@/components/types';
import { userGuide } from '@/i18n/user-guide';
import { feedbackIssueUrl } from '@/lib/muqun-links';
import { localizedPath, siteLocaleCodes, defaultLocale } from '@/lib/locales';

export function getStaticPaths() {
  return siteLocaleCodes.map((code) => ({
    params: { lang: code === defaultLocale ? undefined : code },
    props: { locale: code },
  }));
}

const { locale } = Astro.props;
const guide = userGuide[locale];
const isZhCN = locale === 'zh-CN';

const copyLabel = 'Copy';
const copiedLabel = 'Copied';

const privacyPath = localizedPath('/privacy', locale);
const themesPath = localizedPath('/themes', locale);

/**
 * Status line entries. Addressing the guide as a tmux session:
 * muqun  0:start  1:terminal  2:opencode  3:gateway  4:themes  5:debug  6:contact
 */
const sections: StatusLineItem[] = [
  { key: '0', id: 'get-started', label: 'start', srLabel: guide.getStarted.heading },
  { key: '1', id: 'terminal', label: 'terminal', srLabel: guide.terminal.heading },
  { key: '2', id: 'opencode', label: 'opencode', srLabel: guide.opencode.heading },
  { key: '3', id: 'gateway', label: 'gateway', srLabel: guide.gateway.heading },
  { key: '4', id: 'themes', label: 'themes', srLabel: guide.themes.heading },
  { key: '5', id: 'troubleshooting', label: 'debug', srLabel: guide.troubleshooting.heading },
  { key: '6', id: 'contact', label: 'contact', srLabel: guide.contact.heading },
];

---

<Layout
  lang={locale}
  title={guide.metaTitle}
  description={guide.metaDescription}
  sections={sections}
  version="1.3.0"
>
  {/* =========================================================================
      HERO: Guide Overview & Interactive Chapter Navigator
      ========================================================================= */}
  <Band tone="cream" class="mq-guide-hero-band">
    <div class="mq-guide-hero">
      <div class="mq-guide-badge">
        <span class="mq-guide-badge__pulse" aria-hidden="true"></span>
        <span class="mq-mono-label">{guide.hero.badge}</span>
      </div>

      <Display level={1} size="display-sm" class="mq-guide-hero__title">
        {guide.hero.heading}
      </Display>

      <div class="mq-guide-hero__lead">
        <Prose size="lead">{guide.hero.lead}</Prose>
      </div>

      <div class="mq-guide-hero__actions">
        <Button href="#get-started" variant="primary" size="lg">{guide.hero.startCta}</Button>
        <Button href="#troubleshooting" variant="secondary" size="lg">{guide.hero.diagnosticsCta}</Button>
        <Button href={feedbackIssueUrl} variant="quiet" size="lg">{guide.hero.issueCta} ↗</Button>
      </div>

      {/* The Chapter Deck: fast tactile wayfinding into all 7 deep-linked sections */}
      <nav class="mq-guide-deck" aria-label={guide.contentsLabel}>
        <div class="mq-guide-deck__bar">
          <span class="mq-mono-label">{guide.contentsLabel}</span>
          <span class="mq-guide-deck__counter">7 chapters · deep-linkable</span>
        </div>
        <div class="mq-guide-deck__grid">
          {
            guide.contents.map((item, index) => {
              const key = String(index + 1).padStart(2, '0');
              return (
                <a class="mq-deck-card" href={`#${item.id}`}>
                  <div class="mq-deck-card__top">
                    <span class="mq-deck-card__index">{key}</span>
                    <span class="mq-deck-card__slug">#{item.id}</span>
                    <span class="mq-deck-card__arrow" aria-hidden="true">↓</span>
                  </div>
                  <h2 class="mq-deck-card__title">{item.label}</h2>
                  <p class="mq-deck-card__desc">{item.desc}</p>
                </a>
              );
            })
          }
        </div>
      </nav>
    </div>
  </Band>

  {/* =========================================================================
      CHAPTER 01: GET STARTED (#get-started)
      ========================================================================= */}
  <Band tone="recessed" id="get-started">
    <div class="mq-guide-pane-bar" aria-hidden="true">
      <span class="mq-guide-pane-bar__dot"></span>
      <span class="mq-guide-pane-bar__tag"><span class="mq-guide-pane-bar__num">01</span>:get-started</span>
      <span class="mq-guide-pane-bar__rule"></span>
      <span class="mq-guide-pane-bar__meta">procedure · ~5 min</span>
    </div>

    <SectionHeading eyebrow={guide.getStarted.eyebrow} title={guide.getStarted.heading} level={2}>
      {guide.getStarted.lead}
    </SectionHeading>

    {/* Pre-flight checklist before running commands */}
    <div class="mq-guide-preflight">
      <div class="mq-guide-preflight__header">
        <span class="mq-mono-label">PRE-FLIGHT REQUIREMENTS</span>
        <span class="mq-guide-preflight__badge">check before installing</span>
      </div>
      <FactList items={guide.getStarted.requirements} />
    </div>

    {/* The 4-step installation & pairing procedure */}
    <div class="mq-guide-steps-wrap">
      <Steps>
        {
          guide.getStarted.steps.map((step, idx) => (
            <Step title={step.title}>
              <Prose>{step.body}</Prose>

              {/* Step 2 start mode comparison deck */}
              {idx === 1 && step.commands && step.commands.length >= 2 ? (
                <div class="mq-guide-start-options">
                  <div class="mq-start-option">
                    <div class="mq-start-option__header">
                      <span class="mq-mono-label mq-start-option__tag">OPTION A · DIRECT</span>
                      <h4 class="mq-start-option__title">Background Process</h4>
                    </div>
                    <Prose size="small">{step.commands[0].detail}</Prose>
                    <CodeBlock
                      copy
                      wrap
                      code={step.commands[0].code}
                      label={step.commands[0].label}
                      copyLabel={copyLabel}
                      copiedLabel={copiedLabel}
                    />
                  </div>

                  <div class="mq-start-option">
                    <div class="mq-start-option__header">
                      <span class="mq-mono-label mq-start-option__tag">OPTION B · SERVICE</span>
                      <h4 class="mq-start-option__title">Supervisor / Login Daemon</h4>
                    </div>
                    <Prose size="small">{step.commands[1].detail}</Prose>
                    <CodeBlock
                      copy
                      wrap
                      code={step.commands[1].code}
                      label={step.commands[1].label}
                      copyLabel={copyLabel}
                      copiedLabel={copiedLabel}
                    />
                  </div>
                </div>
              ) : (
                step.commands?.map((command) => (
                  <div class="mq-guide-step-code">
                    {command.detail && <Prose size="small">{command.detail}</Prose>}
                    <CodeBlock
                      copy
                      wrap
                      code={command.code}
                      label={command.label}
                      copyLabel={copyLabel}
                      copiedLabel={copiedLabel}
                    />
                  </div>
                ))
              )}

              {step.note && (
                <div class="mq-guide-callout mq-guide-callout--rule">
                  <span class="mq-guide-callout__marker" aria-hidden="true">!</span>
                  <Prose size="small">{step.note}</Prose>
                </div>
              )}
            </Step>
          ))
        }
      </Steps>
    </div>

    {/* Pairing Tips */}
    <div class="mq-guide-tips-grid">
      <div class="mq-guide-tip-card">
        <div class="mq-guide-tip-card__header">
          <span class="mq-mono-label">MANUAL ADDRESS PAIRING</span>
        </div>
        <Prose size="small">{guide.getStarted.pairingNote}</Prose>
      </div>
      <div class="mq-guide-tip-card">
        <div class="mq-guide-tip-card__header">
          <span class="mq-mono-label">CODE VALIDITY & RETRIES</span>
        </div>
        <Prose size="small">{guide.getStarted.codeNote}</Prose>
      </div>
    </div>

    {/* Tailscale Private Network recommendation */}
    {!isZhCN && guide.getStarted.networkHeading && (
      <div class="mq-guide-network-card">
        <div class="mq-guide-network-card__header">
          <span class="mq-mono-label">{guide.getStarted.networkBadge}</span>
          <h3 class="mq-subheading">{guide.getStarted.networkHeading}</h3>
        </div>
        <Prose>{guide.getStarted.networkBody}</Prose>
      </div>
    )}
  </Band>

  {/* =========================================================================
      CHAPTER 02: THE TERMINAL (#terminal)
      ========================================================================= */}
  <Band tone="cream" id="terminal">
    <div class="mq-guide-pane-bar" aria-hidden="true">
      <span class="mq-guide-pane-bar__dot"></span>
      <span class="mq-guide-pane-bar__tag"><span class="mq-guide-pane-bar__num">02</span>:terminal</span>
      <span class="mq-guide-pane-bar__rule"></span>
      <span class="mq-guide-pane-bar__meta">workspace · group.panel</span>
    </div>

    <SectionHeading eyebrow={guide.terminal.eyebrow} title={guide.terminal.heading} level={2}>
      {guide.terminal.lead}
    </SectionHeading>

    {/* Split: Hierarchy & phone device shot */}
    <div class="mq-guide-split">
      <div class="mq-guide-split__left">
        <div class="mq-guide-group-title">
          <span class="mq-mono-label">WORKSPACE ARCHITECTURE</span>
        </div>
        <div class="mq-guide-cards-grid">
          {
            guide.terminal.entries.slice(0, 3).map((entry) => (
              <article class="mq-guide-card">
                <h3 class="mq-guide-card__title">{entry.term}</h3>
                <Prose size="small">{entry.detail}</Prose>
              </article>
            ))
          }
        </div>
      </div>
      <div class="mq-guide-split__right">
        <DeviceShot name="screen-terminal" alt={guide.terminal.shotAlt} width="14rem" raised />
      </div>
    </div>

    {/* Additional terminal features & developer tools */}
    <div class="mq-guide-section-block">
      <div class="mq-guide-group-title">
        <span class="mq-mono-label">CONTROLS, EDITORS & DEVELOPER TOOLS</span>
      </div>
      <Grid min="19rem">
        {
          guide.terminal.entries.slice(3).map((entry) => (
            <article class="mq-guide-card">
              <h3 class="mq-guide-card__title">{entry.term}</h3>
              <Prose size="small">{entry.detail}</Prose>
            </article>
          ))
        }
      </Grid>
    </div>

    {/* Terminal observer guarantee */}
    <div class="mq-guide-guarantee">
      <span class="mq-guide-guarantee__marker">●</span>
      <Prose>{guide.terminal.note}</Prose>
    </div>
  </Band>

  {/* =========================================================================
      CHAPTER 03: THE OPENCODE AGENT (#opencode)
      ========================================================================= */}
  <Band tone="cream" tight id="opencode">
    <div class="mq-guide-pane-bar" aria-hidden="true">
      <span class="mq-guide-pane-bar__dot"></span>
      <span class="mq-guide-pane-bar__tag"><span class="mq-guide-pane-bar__num">03</span>:opencode</span>
      <span class="mq-guide-pane-bar__rule"></span>
      <span class="mq-guide-pane-bar__meta">autonomous agent</span>
    </div>

    <SectionHeading eyebrow={guide.opencode.eyebrow} title={guide.opencode.heading} level={2}>
      {guide.opencode.lead}
    </SectionHeading>

    {/* Zero-Account / Local Credential Security Guarantee */}
    <div class="mq-guide-security-claim">
      <div class="mq-guide-security-claim__badge">
        <span class="mq-mono-label">LOCAL RUNTIME · ZERO ACCOUNT</span>
      </div>
      <h3 class="mq-guide-security-claim__title">Your computer talks directly to your model provider.</h3>
      <Prose>{guide.opencode.noSignIn}</Prose>
    </div>

    {/* Prerequisites */}
    <div class="mq-guide-preflight">
      <div class="mq-guide-preflight__header">
        <span class="mq-mono-label">{guide.opencode.prerequisitesHeading.toUpperCase()}</span>
      </div>
      <FactList items={guide.opencode.prerequisites} />
    </div>

    {/* OpenCode Feature Grid */}
    <div class="mq-guide-section-block">
      <div class="mq-guide-group-title">
        <span class="mq-mono-label">AGENT CAPABILITIES & WORKFLOW</span>
      </div>
      <Grid min="19rem">
        {
          guide.opencode.entries.map((entry) => (
            <article class="mq-guide-card">
              <h3 class="mq-guide-card__title">{entry.term}</h3>
              <Prose size="small">{entry.detail}</Prose>
            </article>
          ))
        }
      </Grid>
    </div>

    {/* Tool calls note */}
    <div class="mq-guide-guarantee">
      <span class="mq-guide-guarantee__marker">●</span>
      <Prose>{guide.opencode.note}</Prose>
    </div>
  </Band>

  {/* =========================================================================
      CHAPTER 04: CONFIGURING THE GATEWAY (#gateway)
      ========================================================================= */}
  <Band tone="recessed" id="gateway">
    <div class="mq-guide-pane-bar" aria-hidden="true">
      <span class="mq-guide-pane-bar__dot"></span>
      <span class="mq-guide-pane-bar__tag"><span class="mq-guide-pane-bar__num">04</span>:gateway</span>
      <span class="mq-guide-pane-bar__rule"></span>
      <span class="mq-guide-pane-bar__meta">config.json reference</span>
    </div>

    <SectionHeading eyebrow={guide.gateway.eyebrow} title={guide.gateway.heading} level={2}>
      {guide.gateway.lead}
    </SectionHeading>

    {/* Config File Location */}
    <div class="mq-guide-config-panel">
      <div class="mq-guide-config-panel__header">
        <h3 class="mq-subheading">{guide.gateway.configHeading}</h3>
        <span class="mq-mono-label">JSON SCHEMA</span>
      </div>
      <Prose>{guide.gateway.configBody}</Prose>
      <div class="mq-guide-config-panel__code">
        <CodeBlock
          copy
          wrap
          code={guide.gateway.configPath}
          label={guide.gateway.configPathLabel}
          copyLabel={copyLabel}
          copiedLabel={copiedLabel}
        />
      </div>
    </div>

    {/* Configuration Keys Matrix */}
    <div class="mq-guide-section-block">
      <div class="mq-guide-group-title">
        <span class="mq-mono-label">CONFIGURATION KEYS REFERENCE</span>
      </div>
      <div class="mq-guide-keys-matrix">
        {
          guide.gateway.configKeys.map((entry) => (
            <article class="mq-key-row">
              <div class="mq-key-row__name">
                <code class="mq-mono mq-key-code">{entry.term}</code>
              </div>
              <div class="mq-key-row__desc">
                <Prose size="small">{entry.detail}</Prose>
              </div>
            </article>
          ))
        }
      </div>
    </div>

    {/* Ports Specifications */}
    <div class="mq-guide-section-block">
      <div class="mq-guide-group-title">
        <span class="mq-mono-label">{guide.gateway.portsHeading.toUpperCase()}</span>
      </div>
      <Grid min="16rem">
        {
          guide.gateway.portsRows.map((row) => (
            <div class="mq-port-card">
              <h4 class="mq-port-card__term">{row.term}</h4>
              <Prose size="small">{row.detail}</Prose>
            </div>
          ))
        }
      </Grid>
    </div>

    {/* Two Ways to Keep it Running: Side-by-Side Comparison */}
    <div class="mq-guide-section-block">
      <div class="mq-guide-group-title">
        <span class="mq-mono-label">{guide.gateway.modesHeading.toUpperCase()}</span>
      </div>
      <Grid min="20rem">
        {
          guide.gateway.modes.map((mode) => (
            <article class="mq-mode-card">
              <div class="mq-mode-card__top">
                <span class="mq-mono-label mq-mode-card__badge">{mode.label.toUpperCase()}</span>
                <h4 class="mq-mode-card__title">{mode.title}</h4>
              </div>
              <div class="mq-mode-card__table">
                {mode.rows.map((row) => (
                  <div class="mq-mode-card__row">
                    <span class="mq-mode-card__key">{row.term}</span>
                    <span class="mq-mode-card__val"><Prose size="small">{row.detail}</Prose></span>
                  </div>
                ))}
              </div>
              <div class="mq-mode-card__code">
                <CodeBlock
                  copy
                  wrap
                  code={mode.code}
                  label={mode.label}
                  copyLabel={copyLabel}
                  copiedLabel={copiedLabel}
                />
              </div>
            </article>
          ))
        }
      </Grid>
      <div class="mq-guide-callout mq-guide-callout--rule">
        <span class="mq-guide-callout__marker" aria-hidden="true">!</span>
        <Prose size="small">{guide.gateway.modesNote}</Prose>
      </div>
    </div>

    {/* OpenCode Autostart Sequence */}
    <div class="mq-guide-section-block">
      <div class="mq-guide-group-title">
        <span class="mq-mono-label">{guide.gateway.autostartHeading.toUpperCase()}</span>
      </div>
      <ol class="mq-autostart-sequence">
        {
          guide.gateway.autostartSteps.map((step, index) => (
            <li class="mq-autostart-sequence__item">
              <span class="mq-autostart-sequence__num" aria-hidden="true">
                0{index + 1}
              </span>
              <div class="mq-autostart-sequence__body">
                <Prose size="small">{step}</Prose>
              </div>
            </li>
          ))
        }
      </ol>
      <div class="mq-guide-callout">
        <span class="mq-guide-callout__marker">●</span>
        <Prose size="small">{guide.gateway.autostartNote}</Prose>
      </div>
      <div class="mq-guide-step-code">
        <CodeBlock
          copy
          wrap
          code={guide.gateway.autostartOff}
          label={guide.gateway.autostartOffLabel}
          copyLabel={copyLabel}
          copiedLabel={copiedLabel}
        />
      </div>
    </div>

    {/* Pairing Manager Keymap */}
    <div class="mq-guide-section-block">
      <div class="mq-guide-group-title">
        <span class="mq-mono-label">{guide.gateway.managerHeading.toUpperCase()}</span>
      </div>
      <Prose>{guide.gateway.managerBody}</Prose>
      <div class="mq-manager-keymap">
        {
          guide.gateway.managerKeys.map((entry) => (
            <div class="mq-manager-keymap__item">
              <kbd class="mq-key-pill">{entry.term}</kbd>
              <div class="mq-manager-keymap__desc">
                <Prose size="small">{entry.detail}</Prose>
              </div>
            </div>
          ))
        }
      </div>
    </div>

    {/* Capabilities, Upgrade & Logs */}
    <div class="mq-guide-section-block">
      <Grid min="20rem">
        <article class="mq-guide-card">
          <h3 class="mq-guide-card__title">{guide.gateway.capabilitiesHeading}</h3>
          <Prose size="small">{guide.gateway.capabilitiesBody}</Prose>
        </article>
        <article class="mq-guide-card">
          <h3 class="mq-guide-card__title">{guide.gateway.upgradeHeading}</h3>
          <Prose size="small">{guide.gateway.upgradeBody}</Prose>
        </article>
      </Grid>
    </div>

    <div class="mq-guide-section-block">
      <div class="mq-guide-config-panel">
        <div class="mq-guide-config-panel__header">
          <h3 class="mq-subheading">{guide.gateway.logsHeading}</h3>
          <span class="mq-mono-label">DIAGNOSTICS</span>
        </div>
        <Prose>{guide.gateway.logsBody}</Prose>
        <div class="mq-guide-config-panel__code">
          <CodeBlock
            copy
            wrap
            code={guide.gateway.logsCommand}
            label={guide.gateway.logsCommandLabel}
            copyLabel={copyLabel}
            copiedLabel={copiedLabel}
          />
        </div>
      </div>
    </div>
  </Band>

  {/* =========================================================================
      CHAPTER 05: THEMES (#themes)
      ========================================================================= */}
  <Band tone="cream" id="themes">
    <div class="mq-guide-pane-bar" aria-hidden="true">
      <span class="mq-guide-pane-bar__dot"></span>
      <span class="mq-guide-pane-bar__tag"><span class="mq-guide-pane-bar__num">05</span>:themes</span>
      <span class="mq-guide-pane-bar__rule"></span>
      <span class="mq-guide-pane-bar__meta">24 bundled packs</span>
    </div>

    <SectionHeading eyebrow={guide.themes.eyebrow} title={guide.themes.heading} level={2}>
      {guide.themes.lead}
    </SectionHeading>

    <Grid min="19rem">
      {
        guide.themes.entries.map((entry) => (
          <article class="mq-guide-card">
            <h3 class="mq-guide-card__title">{entry.term}</h3>
            <Prose size="small">{entry.detail}</Prose>
          </article>
        ))
      }
    </Grid>

    <div class="mq-support-link">
      <Button href={themesPath} variant="quiet" arrow>{guide.themes.galleryLink}</Button>
    </div>
  </Band>

  {/* =========================================================================
      CHAPTER 06: TROUBLESHOOTING (#troubleshooting)
      ========================================================================= */}
  <Band tone="recessed" id="troubleshooting">
    <div class="mq-guide-pane-bar" aria-hidden="true">
      <span class="mq-guide-pane-bar__dot"></span>
      <span class="mq-guide-pane-bar__tag"><span class="mq-guide-pane-bar__num">06</span>:troubleshooting</span>
      <span class="mq-guide-pane-bar__rule"></span>
      <span class="mq-guide-pane-bar__meta">diagnostics & checks</span>
    </div>

    <SectionHeading
      eyebrow={guide.troubleshooting.eyebrow}
      title={guide.troubleshooting.heading}
      level={2}
    >
      {guide.troubleshooting.lead}
    </SectionHeading>

    {/* Part 1: Quick Checks (Commonest issues) */}
    <div class="mq-guide-section-block">
      <div class="mq-guide-group-title">
        <span class="mq-mono-label">{guide.troubleshooting.checksHeading.toUpperCase()}</span>
      </div>
      <Grid min="20rem">
        {
          guide.troubleshooting.checks.map((check) => (
            <article class="mq-guide-card mq-guide-card--highlight">
              <h4 class="mq-guide-card__title">{check.term}</h4>
              <Prose size="small">{check.detail}</Prose>
            </article>
          ))
        }
      </Grid>
    </div>

    {/* Part 2: Diagnostic Solutions */}
    <div class="mq-guide-section-block">
      <div class="mq-guide-group-title">
        <span class="mq-mono-label">DIAGNOSTIC SOLUTIONS</span>
      </div>
      <Grid min="20rem">
        {
          guide.troubleshooting.entries.map((entry) => (
            <article class="mq-guide-card">
              <h3 class="mq-guide-card__title">{entry.term}</h3>
              <Prose size="small">{entry.detail}</Prose>
            </article>
          ))
        }
      </Grid>
    </div>
  </Band>

  {/* =========================================================================
      CHAPTER 07: CONTACT & SAFE REPORTING (#contact)
      ========================================================================= */}
  <Band tone="cream" tight id="contact">
    <div class="mq-guide-pane-bar" aria-hidden="true">
      <span class="mq-guide-pane-bar__dot"></span>
