---
/** Localized privacy policy, shared by every published locale. */
import Layout from "@/layouts/Layout.astro";
import { privacyTranslations } from "@/i18n/privacy-translations";
import Band from "@/components/Band.astro";
import Display from "@/components/Display.astro";
import Prose from "@/components/Prose.astro";
import { getChrome } from "@/i18n/chrome";
import { getMuqunCopy } from "@/i18n/muqun";
import { supportEmail } from "@/lib/muqun-links";
import { siteLocaleCodes, defaultLocale } from "@/lib/locales";

export function getStaticPaths() {
  return siteLocaleCodes.map((code) => ({
    params: { lang: code === defaultLocale ? undefined : code },
    props: { locale: code },
  }));
}

/**
 * `locale` is inferred from `getStaticPaths` above rather than declared as a
 * `Props` interface: with both, the interface is the one TypeScript ignores,
 * so it is a second declaration of the same fact that nothing checks.
 */
const { locale } = Astro.props;
const chrome = getChrome(locale);
const translated = privacyTranslations[locale];

/**
 * Edited by hand when the policy is. Not a build date: a page that claims to
 * have been revised every time the site is deployed is telling the reader
 * nothing, and telling a reviewer something false.
 */
const lastUpdated = "October 23, 2026";

const description = getMuqunCopy(locale).meta.description;
---

<Layout
  lang={locale}
  title={`${chrome.privacy.title} — ${chrome.site.name}`}
  description={description}
>
  {/* Narrow, because this is the one page on the site that is read rather
      than scanned: 34em of measure and nothing beside it. */}
  <Band tone="cream" contain="narrow" containerClass="mq-policy-container">
    <header class="mq-policy-head">
      <p class="mq-mono-label">{chrome.site.name}</p>
      <Display level={1} size="display-sm" lines={1}>
        {chrome.privacy.title}
      </Display>
      <Prose size="small">
        {chrome.privacy.lastUpdatedLabel}: {lastUpdated}
      </Prose>
    </header>

    <Prose as="article" full lang={locale}>
      <p>{translated.intro}</p>
      {translated.sections.map((section, sectionIndex) => (
        <section>
          <h2>{section.title}</h2>
          {section.paragraphs.map((paragraph, paragraphIndex) => (
            <p>
              {/* Split complete sentences so inline links keep each locale’s own spacing. */}
              {paragraph
                .split(/(Tailscale)/u)
                .map((part) =>
                  part === "Tailscale" ? (
                    <a href="https://tailscale.com/">{part}</a>
                  ) : (
                    part
                  ),
                )}
              {sectionIndex === translated.sections.length - 1 &&
                paragraphIndex === section.paragraphs.length - 1 && (
                  <Fragment>
                    {" "}
                    <a href={`mailto:${supportEmail}`}>{supportEmail}</a>
                  </Fragment>
                )}
            </p>
          ))}
        </section>
      ))}
    </Prose>
  </Band>
</Layout>

<style>
  :global(.mq-policy-container) {
    max-inline-size: 800px;
  }
  :global(.mq-policy-container .mq-prose) {
    line-height: 1.85;
  }
  @media (max-width: 699px) {
    .mq-policy-head {
      margin-block-end: 32px;
      padding-block-end: 24px;
    }
    :global(.mq-policy-container .mq-prose) {
      font-size: 16px;
    }
  }

  .mq-policy-head {
    display: grid;
    gap: var(--mq-space-4);
    margin-block-end: var(--mq-space-12);
    padding-block-end: var(--mq-space-8);
    border-block-end: 1px solid var(--mq-hairline);
  }
</style>
