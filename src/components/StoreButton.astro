---
/**
 * A store link with its badge, at a size.
 *
 * It exists for one reason: an inline `<svg>` with a `viewBox` and no
 * dimensions is a replaced element with no intrinsic size, so it takes the
 * width it is offered. Dropped straight into a page that never sized it, the
 * Google Play mark grew to the full width of the viewport -- which is exactly
 * what the first screenshot of this site showed. The glyph is sized here,
 * once, in the component that owns it, so no caller can forget.
 *
 * Everything else is `Button`'s: the coral fill takes an ink label, the
 * control is 44px tall, and a `href` makes it a real anchor.
 */
import Button from './Button.astro';

interface Props {
  store: 'app-store' | 'play';
  href: string;
  /** Translated. The store's own name is part of it, e.g. "Get it on Google Play". */
  label: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  class?: string;
}

const { store, href, label, variant = 'secondary', size = 'md', class: className } = Astro.props;
---

<Button href={href} variant={variant} size={size} class={['mq-store', className].filter(Boolean).join(' ')}>
  {
    store === 'app-store' ? (
      <svg
        class="mq-store__glyph"
        viewBox="0 0 384 512"
        width="14"
        height="18"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M318.7 268.7c-.2-36.7 16.4-64.4 50-84.8-18.8-26.9-47.2-41.7-84.7-44.6-35.5-2.8-74.3 20.7-88.5 20.7-15 0-49.4-19.7-76.4-19.7C63.3 141.2 4 184.8 4 273.5q0 39.3 14.4 81.2c12.8 36.7 59 126.7 107.2 125.2 25.2-.6 43-17.9 75.8-17.9 31.8 0 48.3 17.9 76.4 17.9 48.6-.7 90.4-82.5 102.6-119.3-65.2-30.7-61.7-90-61.7-91.9zm-56.6-164.2c27.3-32.4 24.8-61.9 24-72.5-24.1 1.4-52 16.4-67.9 34.9-17.5 19.8-27.8 44.3-25.6 71.9 26.1 2 49.9-11.4 69.5-34.3z" />
      </svg>
    ) : (
      <svg
        class="mq-store__glyph"
        viewBox="0 0 512 512"
        width="18"
        height="18"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
      >
        <path fill="#00d0ff" d="M43.6 25.5c-2.9 3-4.6 7.7-4.6 13.8v433.4c0 6.1 1.7 10.8 4.6 13.8l1.5 1.4L288 258.6v-5.2L45.1 24.1z" />
        <path fill="#ffce00" d="M369 339.1 288 258.6v-5.2l81.1-80.5 1.8 1.1 96 54.6c27.4 15.6 27.4 41.1 0 56.7l-96 54.5z" />
        <path fill="#ff3b44" d="M370.8 338 288 256 43.6 500.5c9 9.6 24 10.7 40.8 1.2z" />
        <path fill="#00e677" d="M370.8 174 84.4 11.3C67.6 1.8 52.6 3 43.6 12.6L288 256z" />
      </svg>
    )
  }
  {label}
</Button>

<style>
  /* Both axes fixed. `height: auto` from the element defaults would still let
     the width run, which is the bug this component exists to close. */
  .mq-store__glyph {
    block-size: 18px;
    inline-size: auto;
    max-inline-size: 20px;
    flex: 0 0 auto;
  }
</style>
