---
import { desktopCopy } from "@/i18n/desktop";
import { desktopInstallation } from "@/i18n/desktop-installation";
import { localizedPath, type SiteLocale } from "@/lib/locales";

interface Props {
  locale: SiteLocale;
}
const { locale } = Astro.props;
const copy = desktopCopy[locale];
const installation = desktopInstallation[locale];
const sections = [
  { id: "install", label: installation.title },
  { id: "first-session", label: copy.start },
  { id: "shortcuts", label: copy.shortcuts },
  { id: "help", label: copy.troubleshooting },
];
const keys = [
  "Ctrl / ⌘ + K",
  "Ctrl / ⌘ + P",
  "Ctrl / ⌘ + B",
  "Ctrl / ⌘ + /",
  "Enter",
  "Shift + Enter",
];
---

<section id="guide" class="desktop-guide" aria-labelledby="desktop-guide-title">
  <header class="desktop-guide-header">
    <p class="desktop-eyebrow">MUQUN DESKTOP / GUIDE</p>
    <h2 id="desktop-guide-title">{copy.guideTitle}</h2>
    <nav class="desktop-guide-chapters" aria-label={copy.guide}>
      {sections.map(({ id, label }, index) => (
        <a href={`#${id}`}>
          <span>0{index + 1}</span>
          {label}
          <span aria-hidden="true">↓</span>
        </a>
      ))}
    </nav>
  </header>
  <div class="desktop-guide-grid">
    <aside class="desktop-guide-nav">
      <span class="desktop-mono">DESKTOP / GUIDE</span>
      <nav aria-label={copy.guide}>
        {sections.map(({ id, label }) => (
          <a href={`#${id}`}>{label}</a>
        ))}
      </nav>
    </aside>
    <div class="desktop-guide-content">
      <section id="first-session">
        <p class="desktop-eyebrow">02 / FIRST SESSION</p>
        <h3>{copy.start}</h3>
        <ol class="desktop-guide-steps">
          {copy.steps.map(([title, body], index) => (
            <li>
              <span class="desktop-mono">0{index + 1}</span>
              <div>
                <h4>{title}</h4>
                <p>{body}</p>
              </div>
            </li>
          ))}
        </ol>
        <div class="desktop-guide-note">
          <h4>{copy.local[0]}</h4>
          <p>{copy.local[1]}</p>
          <h4>{copy.remote[0]}</h4>
          <p>{copy.remote[1]}</p>
          <a
            class="desktop-text-link"
            href={`${localizedPath("/support", locale)}#gateway`}
          >
            Gateway →
          </a>
        </div>
      </section>
      <section id="shortcuts">
        <p class="desktop-eyebrow">03 / KEYBOARD</p>
        <h3>{copy.shortcuts}</h3>
        <dl class="desktop-shortcuts">
          {copy.keys.map((label, index) => (
            <div>
              <dt>{label}</dt>
              <dd>
                <kbd>{keys[index]}</kbd>
              </dd>
            </div>
          ))}
        </dl>
      </section>
      <section id="help">
        <p class="desktop-eyebrow">04 / HELP</p>
        <h3>{copy.troubleshooting}</h3>
        <details class="desktop-requirements">
          <summary>{installation.requirements}</summary>
          <p>{installation.details}</p>
          <p>{copy.compatibility}</p>
        </details>
        <div class="desktop-guide-fixes">
          {copy.fixes.map(([title, body]) => (
            <article>
              <h4>{title}</h4>
              <p>{body}</p>
            </article>
          ))}
        </div>
      </section>
    </div>
  </div>
</section>
