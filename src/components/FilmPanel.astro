---
/** A responsive film poster; video bytes load only after an explicit play. */
interface Props {
  /** The film. Loaded on the press and never before it. */
  src: string;
  portraitSrc: string;
  portraitPoster: string;
  /** A frame from the film. */
  poster: string;
  /** Translated. What is on the screen, not "a screenshot". */
  alt: string;
  /** Translated. The play control's accessible name. */
  playLabel: string;
  /** The runtime. Digits stay digits in every locale. */
  length: string;
  class?: string;
}

const { src, portraitSrc, portraitPoster, poster, alt, playLabel, length, class: className } = Astro.props;
---

<figure class:list={['mq-film', className]} data-film data-film-src={src} data-film-portrait-src={portraitSrc}>
  <div class="mq-film__frame">
    <picture>
      <source media="(max-width: 600px)" srcset={portraitPoster} width="1080" height="1920" />
      <img src={poster} alt={alt} width="1920" height="1080" loading="lazy" decoding="async" />
    </picture>
    <button class="mq-film__play" type="button" data-film-play aria-label={playLabel} hidden>
      <span class="mq-film__disc" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M8 5.5v13a1 1 0 0 0 1.53.85l10-6.5a1 1 0 0 0 0-1.7l-10-6.5A1 1 0 0 0 8 5.5Z" />
        </svg>
      </span>
      <span class="mq-film__length">{length}</span>
    </button>
  </div>
</figure>

<style>
  .mq-film {
    inline-size: 100%;
    max-inline-size: 72rem;
    pointer-events: auto;
    margin: 0;
  }

  .mq-film__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--mq-radius-xl);
    border: 1px solid var(--mq-hairline);
    overflow: clip;
    background: var(--mq-canvas);
    box-shadow: var(--mq-shadow-raised);
  }

  .mq-film__frame picture,
  .mq-film__frame img,
  .mq-film__frame :global(video) {
    inline-size: 100%;
    block-size: 100%;
    object-fit: contain;
    display: block;
  }

  @media (max-width: 600px) {
    .mq-film__frame { aspect-ratio: 9 / 16; }
  }

  .mq-film__play {
    position: absolute;
    inset-block-end: var(--mq-space-4);
    inset-inline-start: 50%;
    translate: -50% 0;
    display: inline-flex;
    align-items: center;
    gap: var(--mq-space-2);
    min-block-size: var(--mq-control-height);
    padding-inline: var(--mq-space-4);
    border: 0;
    border-radius: var(--mq-radius-full);
    background: var(--mq-accent);
    color: var(--mq-on-accent); /* ink on coral, 6.17:1 */
    font-family: var(--mq-font-mono);
    font-size: var(--mq-size-mono);
    font-variant-numeric: tabular-nums;
    font-weight: var(--mq-weight-strong);
    cursor: pointer;
  }

  .mq-film__play[hidden] { display: none; }

  .mq-film__disc svg {
    inline-size: 18px;
    block-size: 18px;
  }
</style>

<script>
  /**
   * Reveal the control, then trade the poster for the film on the press.
   *
   * The `<video>` is built here rather than served hidden in the markup:
   * a hidden `<video src>` still hands the browser a URL it may decide to
   * fetch, and this file is several megabytes.
   */
  for (const panel of document.querySelectorAll<HTMLElement>('[data-film]')) {
    const button = panel.querySelector<HTMLButtonElement>('[data-film-play]');
    const frame = button?.parentElement;
    const src = panel.dataset.filmSrc;
    if (!button || !frame || !src) continue;

    button.hidden = false;
    button.addEventListener(
      'click',
      () => {
        const video = document.createElement('video');
        const usePortrait = window.matchMedia('(max-width: 600px)').matches;
        video.src = usePortrait ? (panel.dataset.filmPortraitSrc ?? src) : src;
        frame.style.aspectRatio = usePortrait ? '9 / 16' : '16 / 9';
        video.controls = true;
        // Sound stays off until the viewer turns it on from the controls.
        video.muted = true;
        video.defaultMuted = true;
        video.autoplay = true;
        video.playsInline = true;
        video.setAttribute("aria-label", button.getAttribute("aria-label") ?? "Muqun 3.0");
        frame.replaceChildren(video);
      },
      { once: true },
    );
  }
</script>
