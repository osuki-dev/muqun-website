---
/**
 * The Gateway's pairing panel, as it appears in a terminal session.
 *
 * On the machine's ground in both page themes, because it is the machine's
 * own window: the install script opens this pane next to your others, and the
 * page should show it on the surface it actually has.
 *
 * The QR is a mark, not a code. A real one would encode a real address, and
 * the first thing a reader would do is scan it. The mark says "a QR is here"
 * and the step's text says what to do with it.
 */
interface Props {
  /** Mono, ASCII. The pane's own title. */
  title: string;
  /** ASCII both sides: the key you press and what it does. */
  keys: readonly { key: string; label: string }[];
  /** Translated. Describes the picture. */
  ariaLabel: string;
  class?: string;
}

const { title, keys, ariaLabel, class: className } = Astro.props;
---

<div class:list={['mq-pair', className]} role="img" aria-label={ariaLabel}>
  <p class="mq-pair__title">{title}</p>
  <div class="mq-pair__body">
    <svg
      viewBox="0 0 48 48"
      class="mq-pair__code"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M4 15V8a4 4 0 0 1 4-4h7M33 4h7a4 4 0 0 1 4 4v7M44 33v7a4 4 0 0 1-4 4h-7M15 44H8a4 4 0 0 1-4-4v-7" />
      <rect x="15" y="16" width="18" height="6" rx="2" />
      <rect x="15" y="26" width="18" height="6" rx="2" />
    </svg>
    <ul class="mq-pair__keys">
      {
        keys.map((row) => (
          <li class="mq-pair__key">
            <kbd class="mq-pair__kbd">{row.key}</kbd>
            <span>{row.label}</span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  /*
   * The terminal's own ground, not the band's. `--mq-term-*` are the same
   * tokens the aperture reads, so this panel is in the pack the site ships
   * as its default and stays dark on a light page.
   */
  .mq-pair {
    grid-template-columns: minmax(0, 1fr);
    background: var(--mq-term-bg);
    color: var(--mq-term-fg);
    border: 1px solid color-mix(in srgb, var(--mq-term-fg) 18%, transparent);
    border-radius: var(--mq-radius-md);
    padding: var(--mq-space-4);
    display: grid;
    gap: var(--mq-space-4);
    font-family: var(--mq-font-mono);
    font-size: var(--mq-size-mono);
    line-height: var(--mq-leading-mono);
    max-inline-size: 30rem;
  }

  .mq-pair__title {
    color: color-mix(in srgb, var(--mq-term-fg) 70%, transparent);
    letter-spacing: var(--mq-tracking-mono);
  }

  .mq-pair__body {
    display: flex;
    align-items: center;
    gap: var(--mq-space-5);
    flex-wrap: wrap;
  }

  .mq-pair__code {
    inline-size: 72px;
    block-size: 72px;
    flex: 0 0 auto;
    color: var(--mq-term-accent);
  }

  .mq-pair__keys {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--mq-space-2);
    margin: 0;
    min-inline-size: 0;
  }

  .mq-pair__key {
    display: flex;
    align-items: center;
    gap: var(--mq-space-3);
  }

  .mq-pair__kbd {
    display: inline-grid;
    place-items: center;
    inline-size: 22px;
    block-size: 22px;
    border: 1px solid color-mix(in srgb, var(--mq-term-fg) 40%, transparent);
    border-radius: var(--mq-radius-sm);
    font-family: inherit;
    font-size: var(--mq-size-mono-sm);
    flex: 0 0 auto;
  }
</style>
